# Local API
VITE_API_URL=http://localhost:5100/api

# Marketing site linked from “Back to Sakora”
VITE_WEBSITE_URL=http://localhost:5174

# Customer shops on the website — production: https://sakora.shop/{slug}
VITE_STOREFRONT_URL=http://localhost:5174

# Google Sign-In (same Web client ID as API GOOGLE_CLIENT_ID)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# Production (used automatically by `npm run build` via .env.production)
# VITE_API_URL=https://nexifour.ng/sakora/api
