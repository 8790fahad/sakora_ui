{
  "name": "Inventria Mobile - Inventory Management",
  "short_name": "Inventria",
  "description": "Mobile-first inventory management system for small businesses",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#2563eb",
  "background_color": "#ffffff",
  "lang": "en",
  "scope": "/",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "New Sale",
      "short_name": "Sale",
      "description": "Create a new sale transaction",
      "url": "/sales?new=true",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Add Product",
      "short_name": "Product",
      "description": "Add a new product to inventory",
      "url": "/products?new=true",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Record Expense",
      "short_name": "Expense",
      "description": "Record a new business expense",
      "url": "/expenses?new=true",
      "icons": [
        {
          "src": "/favicon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "View Reports",
      "short_name": "Reports",
      "description": "View business reports and analytics",
      "url": "/reports",
      "icons": [
        {
          "src": "/icons/reports-shortcut.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "dir": "ltr",
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "update_via_cache": "imports"
  },
  "features": [
    "offline",
    "background-sync",
    "push-notifications"
  ]
}
